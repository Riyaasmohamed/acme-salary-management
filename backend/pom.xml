<?xml version="1.0" encoding="UTF-8"?>
<!-- STUDY NOTES: This is the Maven build file. It names the project, picks the Java version and lists the libraries (dependencies) the backend needs. -->
<!-- WHY: The comment is below the <?xml ?> line because XML does not allow anything before that declaration. -->
<!-- WHY: <project> is the root element; the xmlns/xsi attributes only tell tools which POM schema this file follows. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- WHY: 4.0.0 is the only POM model version Maven supports today; it is always this value. -->
    <modelVersion>4.0.0</modelVersion>

    <!-- WHY: Inheriting from spring-boot-starter-parent gives us tested, matching versions for every Spring library, so we do not write version numbers below. -->
    <!-- INTERVIEW: "The parent POM manages dependency versions, so all Spring libraries are known to work together." -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- WHY: Spring Boot 3.5 line; it needs Java 17+ and uses jakarta.* packages. -->
        <version>3.5.16</version>
        <!-- WHY: Empty relativePath means "do not look for the parent in a folder above, download it from Maven Central". -->
        <relativePath/>
    </parent>

    <!-- WHY: groupId + artifactId + version are the "coordinates" that uniquely name this project. -->
    <groupId>com.acme</groupId>
    <artifactId>salary-management</artifactId>
    <version>1.0.0</version>
    <!-- WHY: name and description are only for humans and reports; they do not change the build. -->
    <name>salary-management</name>
    <description>Employee salary management API for ACME HR</description>

    <properties>
        <!-- WHY: Java 17 is a long-term-support version and is the minimum for Spring Boot 3; it also gives us records. -->
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- WHY: starter-web brings Spring MVC, Jackson (JSON) and an embedded Tomcat, so we can build the REST API and run it as a plain jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- WHY: starter-data-jpa brings Hibernate (JPA) and Spring Data repositories, so we do not write JDBC code by hand. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- WHY: starter-validation brings Bean Validation (Hibernate Validator), which makes @NotBlank, @Email, @Valid and our @ValidCurrency work. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- WHY: Flyway runs the versioned SQL files in db/migration at start-up, so the schema is explicit and the same everywhere. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- WHY: H2 is a small Java database; it needs no installation because Maven downloads it like any library. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <!-- WHY: runtime scope: our code never imports H2 classes, it only needs the driver while the app runs. -->
            <scope>runtime</scope>
        </dependency>

        <!-- WHY: starter-test brings JUnit 5, Mockito, AssertJ and Spring's test support (@WebMvcTest, @DataJpaTest). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <!-- WHY: test scope keeps test libraries out of the final jar. -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- WHY: The Spring Boot plugin packages one runnable "fat" jar and adds the "mvn spring-boot:run" command. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
